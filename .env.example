# TEMPLATE ONLY. Enter real values in Easypanel, never in Git.
# These three are required before deploying. Use the identity provider shared
# by this backend and the Android app. Development keys are not production auth.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Sign in on the phone, then copy your user ID from Settings.
OWNER_CLERK_USER_ID=

# Leave empty until the real ChatGPT subscription is authorized and validated.
# Choose CODEX_MODEL from oauth:models; do not invent a model slug.
CODEX_MODEL=

# Existing Pluggy developer application and connection IDs; optional initially.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_IDS=
# Optional; empty disables scheduled copying. Minimum: 6 hours.
PLUGGY_SYNC_INTERVAL_HOURS=

# Exact HTTPS browser origins only. Native Android requests do not need CORS.
CORS_ORIGINS=https://chat.sirch.online
