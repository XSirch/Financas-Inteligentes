{
  "expo": {
    "name": "Áuria — Finanças pessoais",
    "slug": "auria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auria",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10151D",
    "splash": { "backgroundColor": "#10151D", "resizeMode": "contain", "image": "./assets/images/icon.png" },
    "ios": {
      "supportsTablet": false
    },
    "android": { "userInterfaceStyle": "dark", "backgroundColor": "#10151D" },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
